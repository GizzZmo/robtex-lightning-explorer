{
  "name": "robtex-lightning-explorer",
  "version": "1.0.0",
  "description": "Lightning Network & Bitcoin explorer powered by Robtex API — node/channel lookup, recommended peers, recent channels, address & transaction enrichment",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "robtex-ln": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "lightning",
    "bitcoin",
    "robtex",
    "ln",
    "explorer",
    "osint",
    "network-intelligence"
  ],
  "author": "GizzZmo",
  "license": "MIT",
  "dependencies": {
    "@robtex/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
