{
  "name": "robtex-lightning-explorer",
  "version": "1.1.0",
  "description": "Lightning Network & Bitcoin explorer powered by Robtex API — node/channel lookup, recommended peers, recent channels, address & transaction enrichment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "robtex-ln": "./dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lightning",
    "bitcoin",
    "robtex",
    "ln",
    "explorer",
    "osint",
    "network-intelligence",
    "zod"
  ],
  "author": "GizzZmo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GizzZmo/robtex-lightning-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/GizzZmo/robtex-lightning-explorer/issues"
  },
  "homepage": "https://github.com/GizzZmo/robtex-lightning-explorer#readme",
  "dependencies": {
    "@robtex/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "ora": "^8.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
